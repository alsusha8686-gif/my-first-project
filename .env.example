# Токен бота, выданный @BotFather
TELEGRAM_BOT_TOKEN=

# Ваш числовой Telegram chat_id (узнать можно у @userinfobot)
TELEGRAM_CHAT_ID=

# Токен Seller API Wildberries со скоупом "Вопросы и отзывы"
WB_API_TOKEN=

# Данные Yandex Cloud для YandexGPT
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite/latest

# Как часто опрашивать WB API, в секундах (по умолчанию 5 минут)
POLL_INTERVAL_SECONDS=300

# Путь к файлу локальной базы данных (список уже показанных отзывов/вопросов)
DB_PATH=wb_bot.db
